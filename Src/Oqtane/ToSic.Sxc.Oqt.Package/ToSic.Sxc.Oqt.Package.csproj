<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <AssemblyName>ToSic.Sxc.Oqtane.Package</AssemblyName>
    <Configurations>Debug;Release;DebugOqtane;DebugDnn</Configurations>
    <AutoGenerateBindingRedirects>False</AutoGenerateBindingRedirects>
    <!-- Only the all-runtimes Imageflow feed: platform installers share its NuGet ID/version.
         Add local sources without replacing configured feeds needed by transitive dependencies. -->
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);../../packages/;../../../../oqtane/oqtane-imageflow/InstallPackages/NuGet/</RestoreAdditionalProjectSources>
    <!-- Don't generate assembly properties from this XML which should come from the core file, like version - these lines must be in sync in all ToSic.Eav.*.csproj files -->
    <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyCopyrightAttribute>false</GenerateAssemblyCopyrightAttribute>
    <!-- end: Don't generate... -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ToSic.Sxc.Oqt.Client\ToSic.Sxc.Oqt.Client.csproj" />
    <ProjectReference Include="..\ToSic.Sxc.Oqt.Server\ToSic.Sxc.Oqt.Server.csproj" />
    <ProjectReference Include="..\ToSic.Sxc.Oqt.Shared\ToSic.Sxc.Oqt.Shared.csproj" />
  </ItemGroup>

  <Import Project="BuildScripts\LoadBuildConfig.Targets" />

  <Target Name="PostBuild" AfterTargets="Build" DependsOnTargets="BuildConfigTarget" Condition="'$(SourceExist)|$(OqtaneExist)' == 'true|true'">
    <Message Text="Running PostBuild" Importance="high"/>
    <!-- XML documentation -->
    <ItemGroup Condition="'$(Configuration)'=='Release'">
      <AssemblyDocumentation Include="$(OutDir)\ToSic.*.xml" Exclude="**\ToSic.Sxc.Oqtane.Package.xml" />
    </ItemGroup>
    <!-- Run the modification task for each documentation file -->
    <ModifyXmlDocumentation XmlDocumentationPath="%(AssemblyDocumentation.Identity)" Condition="'$(Configuration)'=='Release'"/>
    
    <PropertyGroup>
      <OqtaneInstallPackage Condition=" '$(OqtaneInstallPackage)' == '' ">$(MSBuildProjectDirectory)\..\..\..\InstallPackages\OqtaneModule\</OqtaneInstallPackage>
    </PropertyGroup>
    <Exec Command="IF $(ConfigurationName) == Release (release.cmd $(Source) $(OqtaneInstallPackage) $(TargetFramework))" />
  </Target>

  <Target Name="PostBuild2" AfterTargets="Build" DependsOnTargets="BuildConfigTarget" Condition="'$(ConfigurationName)|$(OqtaneExist)' == 'Debug|true' OR '$(ConfigurationName)|$(OqtaneExist)' == 'DebugOqtane|true'">
    <Message Text="OqtaneTargets='$(OqtaneTargets)'" Importance="High"/>
    <!--Split the paths in OqtaneTargets into individual items-->
    <ItemGroup>
      <OqtaneRoot Include="$(OqtaneTargets)"/>
    </ItemGroup>
  </Target>

  <Target Name="PostBuildForEachItem" AfterTargets="PostBuild2" DependsOnTargets="BuildConfigTarget;PostBuild2" Condition="'$(ConfigurationName)|$(OqtaneExist)' == 'Debug|true' OR '$(ConfigurationName)|$(OqtaneExist)' == 'DebugOqtane|true'" Outputs="%(OqtaneRoot.Identity)">
    <PropertyGroup>
      <CurrentOqtaneRoot>%(OqtaneRoot.Identity)</CurrentOqtaneRoot>
    </PropertyGroup>
    <Message Text="CurrentOqtaneRoot='$(CurrentOqtaneRoot)'" Importance="High"/>
    <MSBuild Projects="$(CurrentOqtaneRoot)Oqtane.Server.csproj" Targets="GetTargetFrameworks" RemoveProperties="TargetFramework;TargetFrameworks">
      <Output TaskParameter="TargetOutputs" ItemName="OqtaneHostFramework" />
    </MSBuild>
    <Error Condition="'@(OqtaneHostFramework->'%(HasSingleTargetFramework)')' != 'true'" Text="Expected a single target framework in $(CurrentOqtaneRoot)Oqtane.Server.csproj." />
    <PropertyGroup>
      <OqtaneHostTargetFramework>@(OqtaneHostFramework->'%(TargetFrameworks)')</OqtaneHostTargetFramework>
      <ModuleDependencyModelPath>$(MSBuildProjectDirectory)\..\ToSic.Sxc.Oqt.Server\bin\$(ConfigurationName)\$(TargetFramework)\Microsoft.Extensions.DependencyModel.dll</ModuleDependencyModelPath>
      <HostDependencyModelPath>$(CurrentOqtaneRoot)bin\$(ConfigurationName)\$(OqtaneHostTargetFramework)\Microsoft.Extensions.DependencyModel.dll</HostDependencyModelPath>
    </PropertyGroup>
    <!-- RuntimeCompilation can require a newer DependencyModel than older Oqtane hosts provide. -->
    <GetAssemblyIdentity AssemblyFiles="$(ModuleDependencyModelPath)">
      <Output TaskParameter="Assemblies" ItemName="ModuleDependencyModel" />
    </GetAssemblyIdentity>
    <GetAssemblyIdentity AssemblyFiles="$(HostDependencyModelPath)" Condition="Exists('$(HostDependencyModelPath)')">
      <Output TaskParameter="Assemblies" ItemName="HostDependencyModel" />
    </GetAssemblyIdentity>
    <PropertyGroup>
      <ModuleDependencyModelVersion>@(ModuleDependencyModel->'%(Version)')</ModuleDependencyModelVersion>
      <HostDependencyModelVersion>@(HostDependencyModel->'%(Version)')</HostDependencyModelVersion>
    </PropertyGroup>
    <Copy SourceFiles="$(ModuleDependencyModelPath)" DestinationFiles="$(HostDependencyModelPath)"
          Condition="'$(HostDependencyModelVersion)' == '' Or $([MSBuild]::VersionLessThan('$(HostDependencyModelVersion)', '$(ModuleDependencyModelVersion)'))" />
    <Exec Command="debug.cmd $(ConfigurationName) &quot;$(CurrentOqtaneRoot)&quot; $(TargetFramework) $(OqtaneHostTargetFramework)" />
  </Target>

  <Target Name="BuildConfigTarget2" AfterTargets="Build" DependsOnTargets="BuildConfigTarget" Condition=" '$(OqtaneExist)' == 'true'">

    <Message Text="------------------------------------------------------------------------------" Importance="high"/>
    <Message Text="$(BuildConfigPath)" Importance="high"/>
    <Message Text="------------------------------------------------------------------------------" Importance="high"/>
    <Message Text="OqtaneTargets:" Importance="high"/>
    <Message Text="$(OqtaneTargets)" Importance="high"/>
    <Message Text="Source:" Importance="high"/>
    <Message Text="$(Source)" Importance="high"/>
    <Message Text="OqtaneInstallPackage:" Importance="high"/>
    <Message Text="$(OqtaneInstallPackage)" Importance="high"/>
    <Message Text="------------------------------------------------------------------------------" Importance="high"/>

  </Target>

</Project>
